# ===========================================================================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and supply your own credentials before running the server.
# ===========================================================================================

# MongoDB Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/prepcraft?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/prepcraft?retryWrites=true&w=majority

# JWT Secret Key for signing authentication tokens (use a random 64-character hex string)
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (Get yours at https://aistudio.google.com/)
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Server Port (default: 3000)
PORT=3000
